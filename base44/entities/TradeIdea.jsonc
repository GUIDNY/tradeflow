{
  "name": "TradeIdea",
  "type": "object",
  "properties": {
    "symbol": {
      "type": "string",
      "description": "Trading symbol (e.g., AAPL, BTC)"
    },
    "side": {
      "type": "string",
      "enum": [
        "buy",
        "sell"
      ],
      "description": "Trade direction"
    },
    "entry_price": {
      "type": "number",
      "description": "Entry price for the trade"
    },
    "stop_loss": {
      "type": "number",
      "description": "Stop loss price"
    },
    "take_profit": {
      "type": "number",
      "description": "Take profit price"
    },
    "qty": {
      "type": "number",
      "description": "Quantity to trade"
    },
    "risk_reward": {
      "type": "number",
      "description": "Risk to reward ratio"
    },
    "reason": {
      "type": "string",
      "description": "Reason for the trade idea"
    },
    "status": {
      "type": "string",
      "enum": [
        "idea",
        "approved",
        "sent",
        "error"
      ],
      "default": "idea",
      "description": "Current status of the trade idea"
    }
  },
  "required": [
    "symbol",
    "side",
    "entry_price",
    "stop_loss",
    "take_profit",
    "qty"
  ]
}